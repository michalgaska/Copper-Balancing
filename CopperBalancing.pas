{------------------------------------------------------------------------------}
function MaxCoord(A, B : TCoord) : TCoord;
begin
    if A > B then
        Result := A
    else
        Result := B;
end;


{------------------------------------------------------------------------------}
function HolderExists(AName : String) : Boolean;
var
    It   : IPCB_BoardIterator;
    Comp : IPCB_Component;
begin
    Result := False;

    It := Board.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eComponentObject));
    It.AddFilter_LayerSet(AllLayers);
    It.AddFilter_Method(eProcessAll);

    Comp := It.FirstPCBObject;
    while Comp <> nil do
    begin
        if Comp.Name.Text = AName then
        begin
            Result := True;
            Break;
        end;
        Comp := It.NextPCBObject;
    end;

    Board.BoardIterator_Destroy(It);
end;


{------------------------------------------------------------------------------}
function CreateHolderComponent(AName : String; ALayer : TLayer) : IPCB_Component;
var
    Comp : IPCB_Component;
begin
    Result := nil;

    Comp := PCBServer.PCBObjectFactory(eComponentObject, eNoDimension, eCreate_Default);
    if Comp = nil then Exit;

    Comp.X := Board.XOrigin;
    Comp.Y := Board.YOrigin;
    Comp.Layer := ALayer;

    Comp.PrimitiveLock := False;
    Comp.Moveable := False;

    Comp.NameOn := False;
    Comp.Name.Text := AName;

    Comp.CommentOn := False;
    Comp.Comment.Text := CB_HOLDER_MARKER;

    Comp.ComponentKind := eComponentKind_Graphical;

    Board.AddPCBObject(Comp);

    PCBServer.SendMessageToRobots(
        Board.I_ObjectAddress,
        c_Broadcast,
        PCBM_BoardRegisteration,
        Comp.I_ObjectAddress
    );

    Result := Comp;
end;


{------------------------------------------------------------------------------}
function PointWithEdgeMarginInsideBoard(X, Y : TCoord) : Boolean;
var
    I        : Integer;
    Angle    : Double;
    Radius   : TCoord;
    PX, PY   : TCoord;
    HalfDiag : TCoord;
begin
    Result := False;

    HalfDiag := MMsToCoord(CB_PAD_SIZE_MM / Sqrt(2.0));
    Radius   := HalfDiag + MMsToCoord(CB_EDGE_CLEAR_MM);

    if not Board.BoardOutline.PointInPolygon(X, Y) then Exit;

    for I := 0 to CB_EDGE_SAMPLES - 1 do
    begin
        Angle := (2.0 * 3.14159265358979323846 * I) / CB_EDGE_SAMPLES;
        PX := X + Round(Radius * Cos(Angle));
        PY := Y + Round(Radius * Sin(Angle));

        if not Board.BoardOutline.PointInPolygon(PX, PY) then Exit;
    end;

    Result := True;
end;


{------------------------------------------------------------------------------}
function CreateCandidatePad(X, Y : TCoord; ALayer : TLayer) : IPCB_Pad;
var
    P        : IPCB_Pad;
    PadCache : TPadCache;
    PadSize  : TCoord;
begin
    Result := nil;

    P := PCBServer.PCBObjectFactory(ePadObject, eNoDimension, eCreate_Default);
    if P = nil then Exit;

    PadSize := MMsToCoord(CB_PAD_SIZE_MM);

    P.Mode := ePadMode_Simple;
    P.X := X;
    P.Y := Y;
    P.Layer := ALayer;

    P.TopXSize := PadSize;
    P.TopYSize := PadSize;

    { Pattern geometry }
    if CB_PATTERN_TYPE = CB_PATTERN_CIRCLE then
    begin
        P.TopShape := eRounded;
        P.Rotation := 0;
    end
    else
    begin
        P.TopShape := eRectangular;

        if CB_PATTERN_TYPE = CB_PATTERN_DIAMOND then
            P.Rotation := 45
        else
            P.Rotation := 0;
    end;

    P.HoleSize := 0;
    P.Name := CB_PAD_MARKER;
    P.Net := nil;

    { Set the cache FIRST.
      Using GetState_Cache / SetState_Cache follows the Altium scripting
      examples and avoids overwriting tenting flags afterwards. }
    PadCache := P.GetState_Cache;

    { Strong negative manual mask expansion is an additional safety net.
      Tenting set below is the authoritative setting. }
    PadCache.SolderMaskExpansion := -PadSize;
    PadCache.SolderMaskExpansionValid := eCacheManual;

    { No paste-mask aperture. }
    PadCache.PasteMaskExpansion := -PadSize;
    PadCache.PasteMaskExpansionValid := eCacheManual;

    P.SetState_Cache(PadCache);

    { IMPORTANT:
      Force tenting AFTER assigning PadCache.
      IsTenting closes both sides; Top/Bottom are set explicitly as well
      because AD exposes independent mask-tenting states. }
    P.IsTenting := True;
    P.IsTenting_Top := True;
    P.IsTenting_Bottom := True;

    P.InvalidateSizeShape;
    P.ValidateSizeShape;

    Result := P;
end;


{------------------------------------------------------------------------------}
function CandidateHasCollision(
    Candidate : IPCB_Pad;
    ALayer    : TLayer;
    CopperRule: IPCB_ClearanceConstraint;
    EdgeRule  : IPCB_ClearanceConstraint
) : Boolean;
var
    Spatial       : IPCB_SpatialIterator;
    Primitive     : IPCB_Primitive;
    Violation     : IPCB_Violation;
    CandidateRect : TCoordRect;
    Layers        : IPCB_LayerSet;
    SearchGap     : TCoord;
begin
    Result := False;

    CandidateRect := Candidate.BoundingRectangle;
    SearchGap := MaxCoord(CopperRule.Gap, EdgeRule.Gap);

    Layers := LayerSet.CreateLayerSet;
    Layers.Include(ALayer);
    Layers.Include(String2Layer('Multi Layer'));
    Layers.Include(String2Layer('Keep Out Layer'));

    Spatial := Board.SpatialIterator_Create;
    Spatial.AddFilter_ObjectSet(AllObjects);
    Spatial.AddFilter_IPCB_LayerSet(Layers);
    Spatial.AddFilter_Area(
        CandidateRect.Left   - SearchGap,
        CandidateRect.Bottom - SearchGap,
        CandidateRect.Right  + SearchGap,
        CandidateRect.Top    + SearchGap
    );

    Primitive := Spatial.FirstPCBObject;

    while Primitive <> nil do
    begin
        if Primitive.I_ObjectAddress <> Candidate.I_ObjectAddress then
        begin
            Violation := nil;

            if Primitive.ObjectId = eRegionObject then
            begin
                if Primitive.Kind = eRegionkind_BoardCutout then
                    Violation := EdgeRule.ActualCheck(Primitive, Candidate)
                else
                    Violation := CopperRule.ActualCheck(Primitive, Candidate);
            end
            else
            begin
                Violation := CopperRule.ActualCheck(Primitive, Candidate);
            end;

            if Violation <> nil then
            begin
                Result := True;
                Break;
            end;
        end;

        Primitive := Spatial.NextPCBObject;
    end;

    Board.SpatialIterator_Destroy(Spatial);
    Layers := nil;
end;


{------------------------------------------------------------------------------}
procedure AttachToHolder(P : IPCB_Pad; Holder : IPCB_Component);
begin
    Holder.AddPCBObject(P);

    PCBServer.SendMessageToRobots(
        Holder.I_ObjectAddress,
        c_Broadcast,
        PCBM_BoardRegisteration,
        P.I_ObjectAddress
    );
end;


{------------------------------------------------------------------------------}
procedure RegisterFreePad(P : IPCB_Pad);
begin
    { In free mode the pad stays directly | layer: the board.
      Under the default Altium Advanced Setting
      PCB.Rules.DeadCopperNoNet = 2, free pads are intentionally
      excluded from the "Dead Copper - Net Not Assigned" DRC report. }
    PCBServer.SendMessageToRobots(
        Board.I_ObjectAddress,
        c_Broadcast,
        PCBM_BoardRegisteration,
        P.I_ObjectAddress
    );
end;


{------------------------------------------------------------------------------}
function GetLayerDisplayName(ALayer : TLayer) : String;
var
    LayerObj : IPCB_LayerObject;
begin
    Result := 'Layer ' + IntToStr(Ord(ALayer));

    if Board.LayerStack = nil then Exit;

    LayerObj := Board.LayerStack.LayerObject[ALayer];

    if LayerObj <> nil then
        Result := LayerObj.Name;
end;


{------------------------------------------------------------------------------}
function EstimateGridPositionsForLayer(ALayer : TLayer) : Integer;
var
    Rect       : TCoordRect;
    X, Y       : TCoord;
    StartX     : TCoord;
    PitchX     : TCoord;
    PitchY     : TCoord;
    Row        : Integer;
    UseStagger : Boolean;
begin
    Result := 0;

    Rect := Board.BoardOutline.BoundingRectangle;

    PitchX := MMsToCoord(CB_PITCH_X_MM);
    PitchY := MMsToCoord(CB_PITCH_Y_MM);

    if PitchX <= 0 then Exit;
    if PitchY <= 0 then Exit;

    UseStagger := False;

    if CB_PATTERN_TYPE = CB_PATTERN_DIAMOND then
        UseStagger := True;

    if CB_PATTERN_TYPE = CB_PATTERN_CIRCLE then
        UseStagger := True;

    Row := 0;
    Y := Rect.Bottom + (PitchY div 2);

    while Y <= Rect.Top do
    begin
        StartX := Rect.Left + (PitchX div 2);

        if UseStagger then
        begin
            if (Row mod 2) = 1 then
                StartX := StartX + (PitchX div 2);
        end;

        X := StartX;

        while X <= Rect.Right do
        begin
            Inc(Result);
            X := X + PitchX;
        end;

        Y := Y + PitchY;
        Inc(Row);
    end;
end;


{------------------------------------------------------------------------------}
procedure GenerateLayer(
    ALayer      : TLayer;
    HolderName  : String;
    CopperRule  : IPCB_ClearanceConstraint;
    EdgeRule    : IPCB_ClearanceConstraint;
    var Added   : Integer;
    var Rejected: Integer
);
var
    Rect        : TCoordRect;
    Holder      : IPCB_Component;
    Candidate   : IPCB_Pad;
    X, Y        : TCoord;
    StartX      : TCoord;
    PitchX      : TCoord;
    PitchY      : TCoord;
    Row         : Integer;
    UseGroup    : Boolean;
    UseStagger  : Boolean;
begin
    SetProgressStatus(
        'Generating: ' + PatternName(0) + ' | layer: ' + GetLayerDisplayName(ALayer)
    );

    Rect := Board.BoardOutline.BoundingRectangle;

    PitchX := MMsToCoord(CB_PITCH_X_MM);
    PitchY := MMsToCoord(CB_PITCH_Y_MM);

    Holder := nil;
    UseGroup := False;

    if CB_GROUP_AS_COMPONENT then
    begin
        if IsOuterLayer(ALayer) then
            UseGroup := True;
    end;

    if UseGroup then
    begin
        Holder := CreateHolderComponent(HolderName, ALayer);

        if Holder = nil then
        begin
            ShowMessage('Could not create holder component: ' + HolderName);
            Exit;
        end;
    end;

    { Squares are aligned. Diamonds and circles are staggered. }
    UseStagger := False;

    if CB_PATTERN_TYPE = CB_PATTERN_DIAMOND then
        UseStagger := True;

    if CB_PATTERN_TYPE = CB_PATTERN_CIRCLE then
        UseStagger := True;

    Row := 0;
    Y := Rect.Bottom + (PitchY div 2);

    while Y <= Rect.Top do
    begin
        StartX := Rect.Left + (PitchX div 2);

        if UseStagger then
        begin
            if (Row mod 2) = 1 then
                StartX := StartX + (PitchX div 2);
        end;

        X := StartX;

        while X <= Rect.Right do
        begin
            if PointWithEdgeMarginInsideBoard(X, Y) then
            begin
                Candidate := CreateCandidatePad(X, Y, ALayer);

                if Candidate <> nil then
                begin
                    Board.AddPCBObject(Candidate);

                    if CandidateHasCollision(
                        Candidate,
                        ALayer,
                        CopperRule,
                        EdgeRule
                    ) then
                    begin
                        Board.RemovePCBObject(Candidate);
                        Inc(Rejected);
                    end
                    else
                    begin
                        if UseGroup then
                            AttachToHolder(Candidate, Holder)
                        else
                            RegisterFreePad(Candidate);

                        Inc(Added);
                    end;
                end;
            end
            else
            begin
                Inc(Rejected);
            end;

            UpdateProgress(1);

            X := X + PitchX;
        end;

        Y := Y + PitchY;
        Inc(Row);
    end;

    if UseGroup then
        Board.ViewManager_GraphicallyInvalidatePrimitive(Holder);
end;


{------------------------------------------------------------------------------}
procedure CollectTaggedFreePads(PadList : TInterfaceList);
var
    It  : IPCB_BoardIterator;
    Pad : IPCB_Pad;
begin
    if PadList = nil then Exit;

    It := Board.BoardIterator_Create;
    if It = nil then Exit;

    Try
        It.AddFilter_ObjectSet(MkSet(ePadObject));
        It.AddFilter_LayerSet(AllLayers);
        It.AddFilter_Method(eProcessAll);

        Pad := It.FirstPCBObject;

        while Pad <> nil do
        begin
            if Pad.Name = CB_PAD_MARKER then
            begin
                { Only free pads generated in normal non-grouped mode. }
                if Pad.InComponent = False then
                    PadList.Add(Pad);
            end;

            Pad := It.NextPCBObject;
        end;

    Finally
        Board.BoardIterator_Destroy(It);
    End;
end;


{------------------------------------------------------------------------------}
procedure CollectMarkedHolders(HolderList : TInterfaceList);
var
    It   : IPCB_BoardIterator;
    Comp : IPCB_Component;
begin
    if HolderList = nil then Exit;

    It := Board.BoardIterator_Create;
    if It = nil then Exit;

    Try
        It.AddFilter_ObjectSet(MkSet(eComponentObject));
        It.AddFilter_LayerSet(AllLayers);
        It.AddFilter_Method(eProcessAll);

        Comp := It.FirstPCBObject;

        while Comp <> nil do
        begin
            if Comp.Comment.Text = CB_HOLDER_MARKER then
                HolderList.Add(Comp);

            Comp := It.NextPCBObject;
        end;

    Finally
        Board.BoardIterator_Destroy(It);
    End;
end;


{------------------------------------------------------------------------------}
procedure RemoveCollectedPads(
    PadList          : TInterfaceList;
    var RemovedCount : Integer
);
var
    I   : Integer;
    Pad : IPCB_Pad;
begin
    if PadList = nil then Exit;

    SetProgressStatus('Removing free balancing elements...');

    for I := 0 to PadList.Count - 1 do
    begin
        Pad := PadList.Items[I];

        if Pad <> nil then
        begin
            Board.RemovePCBObject(Pad);

            { Register deletion with the PCB/Undo system. }
            PCBServer.SendMessageToRobots(
                Board.I_ObjectAddress,
                c_Broadcast,
                PCBM_BoardRegisteration,
                Pad.I_ObjectAddress
            );

            Inc(RemovedCount);
            UpdateProgress(1);
        end;
    end;
end;


{------------------------------------------------------------------------------}
procedure RemoveCollectedHolders(
    HolderList       : TInterfaceList;
    var RemovedCount : Integer
);
var
    I    : Integer;
    Comp : IPCB_Component;
begin
    if HolderList = nil then Exit;

    SetProgressStatus('Removing grouped balancing elements...');

    for I := 0 to HolderList.Count - 1 do
    begin
        Comp := HolderList.Items[I];

        if Comp <> nil then
        begin
            Board.RemovePCBObject(Comp);

            PCBServer.SendMessageToRobots(
                Board.I_ObjectAddress,
                c_Broadcast,
                PCBM_BoardRegisteration,
                Comp.I_ObjectAddress
            );

            Inc(RemovedCount);
            UpdateProgress(1);
        end;
    end;
end;


{------------------------------------------------------------------------------}
procedure RemoveCopperBalance;
var
    RemovedFreePads : Integer;
    RemovedHolders  : Integer;
    TotalToRemove   : Integer;
    PadList         : TInterfaceList;
    HolderList      : TInterfaceList;
begin
    Board := PCBServer.GetCurrentPCBBoard;

    if Board = nil then
    begin
        ShowMessage('Open a PCB document first.');
        Exit;
    end;

    RemovedFreePads := 0;
    RemovedHolders  := 0;

    PadList := TInterfaceList.Create;
    HolderList := TInterfaceList.Create;

    Try
        { IMPORTANT:
          Scan the PCB only once for pads and once for holders.
          Objects are collected first, iterators are destroyed, and only then
          are the objects removed. This is the deletion method recommended by
          Altium for PCB iterators and changes the old O(n^2)-like removal
          behavior into essentially O(n). }
        CollectTaggedFreePads(PadList);
        CollectMarkedHolders(HolderList);

        TotalToRemove := PadList.Count + HolderList.Count;

        if TotalToRemove = 0 then
        begin
            ShowMessage('No generated Copper Balancing elements were found.');
            Exit;
        end;

        ShowProgressWindow(
            'Copper Balancing - Removing',
            'Removing generated balancing elements...',
            TotalToRemove
        );

        PCBServer.PreProcess;
        Try
            RemoveCollectedPads(PadList, RemovedFreePads);
            RemoveCollectedHolders(HolderList, RemovedHolders);

            FinishProgress(0);
        Finally
            PCBServer.PostProcess;
            CloseProgressWindow(0);
        End;

    Finally
        PadList.Free;
        HolderList.Free;
    End;

    Board.ViewManager_FullUpdate;

    ResetParameters;
    AddStringParameter('Action', 'Redraw');
    RunProcess('PCB:Zoom');

    ShowMessage(
        'Copper Balancing was removed from all layers.' + #13#10 + #13#10 +
        'Free elements removed: ' + IntToStr(RemovedFreePads) + #13#10 +
        'Grouped holders removed: ' + IntToStr(RemovedHolders)
    );
end;


{------------------------------------------------------------------------------}
procedure Start;
var
    CopperRule      : IPCB_ClearanceConstraint;
    EdgeRule        : IPCB_ClearanceConstraint;
    Added           : Integer;
    Rejected        : Integer;
    TotalAdded      : Integer;
    TotalRejected   : Integer;
    SelectedLayers  : Integer;
    TotalGridSteps  : Integer;
    I               : Integer;
    HolderName      : String;
    DialogAccepted  : Boolean;
begin
    Board := PCBServer.GetCurrentPCBBoard;

    if Board = nil then
    begin
        ShowMessage('Open a PCB document first.');
        Exit;
    end;

    InitDefaults(0);

    Try
        DialogAccepted := ShowSettingsDialog(0);
    Except
        ShowMessage(
            'One of the numeric values is invalid.' + #13#10 +
            'Use the decimal separator configured in Windows.'
        );
        Exit;
    End;

    if CB_REMOVE_REQUESTED then
    begin
        RemoveCopperBalance;
        Exit;
    end;

    if not DialogAccepted then
        Exit;

    if CB_PAD_SIZE_MM <= 0 then
    begin
        ShowMessage('Element size must be greater than zero.');
        Exit;
    end;

    if CB_PITCH_X_MM <= 0 then
    begin
        ShowMessage('Horizontal spacing X must be greater than zero.');
        Exit;
    end;

    if CB_PITCH_Y_MM <= 0 then
    begin
        ShowMessage('Vertical spacing Y must be greater than zero.');
        Exit;
    end;

    if CB_COPPER_CLEAR_MM < 0 then
    begin
        ShowMessage('Copper clearance cannot be negative.');
        Exit;
    end;

    if CB_EDGE_CLEAR_MM < 0 then
    begin
        ShowMessage('Board edge clearance cannot be negative.');
        Exit;
    end;

    TotalAdded := 0;
    TotalRejected := 0;
    SelectedLayers := 0;
    TotalGridSteps := 0;

    { Calculate progress maximum before modifying the PCB. }
    for I := 0 to CB_LAYER_COUNT - 1 do
    begin
        if CB_LAYER_SELECTED[I] then
        begin
            TotalGridSteps :=
                TotalGridSteps +
                EstimateGridPositionsForLayer(CB_LAYER_IDS[I]);

            Inc(SelectedLayers);
        end;
    end;

    ShowProgressWindow(
        'Copper Balancing - Generating',
        'Preparing generation...',
        TotalGridSteps
    );

    CopperRule := nil;
    EdgeRule := nil;

    PCBServer.PreProcess;
    Try
        CopperRule := PCBServer.PCBRuleFactory(eRule_Clearance);
        CopperRule.Scope1Expression := 'All';
        CopperRule.Scope2Expression := 'All';
        CopperRule.NetScope := eNetScope_AnyNet;
        CopperRule.Name := '__CB_TEMP_COPPER_CLEARANCE__';
        CopperRule.Comment := 'Temporary rule created by CopperBalancing';
        CopperRule.Gap := MMsToCoord(CB_COPPER_CLEAR_MM);
        Board.AddPCBObject(CopperRule);

        EdgeRule := PCBServer.PCBRuleFactory(eRule_Clearance);
        EdgeRule.Scope1Expression := 'All';
        EdgeRule.Scope2Expression := 'All';
        EdgeRule.NetScope := eNetScope_AnyNet;
        EdgeRule.Name := '__CB_TEMP_EDGE_CLEARANCE__';
        EdgeRule.Comment := 'Temporary rule created by CopperBalancing';
        EdgeRule.Gap := MMsToCoord(CB_EDGE_CLEAR_MM);
        Board.AddPCBObject(EdgeRule);

        for I := 0 to CB_LAYER_COUNT - 1 do
        begin
            if CB_LAYER_SELECTED[I] then
            begin
                Added := 0;
                Rejected := 0;

                HolderName := 'CBAL_' + IntToStr(Ord(CB_LAYER_IDS[I]));

                GenerateLayer(
                    CB_LAYER_IDS[I],
                    HolderName,
                    CopperRule,
                    EdgeRule,
                    Added,
                    Rejected
                );

                TotalAdded := TotalAdded + Added;
                TotalRejected := TotalRejected + Rejected;
            end;
        end;

        FinishProgress(0);

    Finally
        if CopperRule <> nil then
            Board.RemovePCBObject(CopperRule);

        if EdgeRule <> nil then
            Board.RemovePCBObject(EdgeRule);

        PCBServer.PostProcess;
        CloseProgressWindow(0);
    End;

    ResetParameters;
    AddStringParameter('Action', 'Redraw');
    RunProcess('PCB:Zoom');

    ShowMessage(
        'Copper Balancing generation completed.' + #13#10 + #13#10 +
        'Pattern: ' + PatternName(0) + #13#10 +
        'Layers processed: ' + IntToStr(SelectedLayers) + #13#10 +
        'Elements added: ' + IntToStr(TotalAdded) + #13#10 +
        'Skipped positions: ' + IntToStr(TotalRejected) + #13#10 + #13#10 +
        'Before release, run DRC and inspect Gerber/ODB++ output.'
    );
end;
