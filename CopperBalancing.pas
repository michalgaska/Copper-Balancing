{==============================================================================
  CopperBalancing_v4_3_AD26.pas
  Altium Designer DelphiScript

  Copper Balancing generator with multi-layer selection, pattern preview, progress bars and fast bulk removal.

  Key option:
    "Group into component"
      ON  -> generated pads belong to COPPER_BALANCE_TOP/BOTTOM
             (easy bulk removal with RemoveCopperBalance)
      OFF -> every generated pad is a FREE IPCB_Pad (SMD, No Net, no paste/mask opening)
             (can be selected/moved/deleted individually)

  Entry points:
    Start                -> open GUI, select one or more signal layers and generate balancing
    RemoveCopperBalance  -> remove generated objects globally | layer: all supported layers
    FixCopperBalanceMasks -> repair Top/Bottom solder-mask tenting | layer: generated free pads

  IMPORTANT:
    Test | layer: a COPY of the PCB first and run DRC after generation.
==============================================================================}

var
    Board : IPCB_Board;

    { Runtime settings filled by the GUI }
    CB_LAYER_IDS          : array[0..127] of TLayer;
    CB_LAYER_SELECTED     : array[0..127] of Boolean;
    CB_LAYER_CHECKS       : array[0..127] of TCheckBox;
    CB_LAYER_COUNT        : Integer;

    CB_PAD_SIZE_MM        : Double;
    CB_PITCH_X_MM         : Double;
    CB_PITCH_Y_MM         : Double;
    CB_COPPER_CLEAR_MM    : Double;
    CB_EDGE_CLEAR_MM      : Double;

    { 0 = aligned squares, 1 = staggered pads, 2 = staggered circles }
    CB_PATTERN_TYPE       : Integer;

    CB_GROUP_AS_COMPONENT : Boolean;
    CB_REMOVE_REQUESTED   : Boolean;

    { Runtime progress window }
    CB_PROGRESS_FORM      : TForm;
    CB_PROGRESS_BAR       : TProgressBar;
    CB_PROGRESS_LABEL     : TLabel;
    CB_PROGRESS_PERCENT   : TLabel;
    CB_PROGRESS_MAX       : Integer;
    CB_PROGRESS_POS       : Integer;
    CB_PROGRESS_LAST_UI   : Integer;

const
    { Conservative board-edge sampling. Higher = safer but slower. }
    CB_EDGE_SAMPLES       = 24;

    { Holder component names used only in grouped mode. }
    { Markers used to safely identify objects generated by this script. }
    CB_PAD_MARKER         = 'CB_BALANCE';
    CB_HOLDER_MARKER      = 'CB_BALANCE_HOLDER';

    CB_PATTERN_SQUARE     = 0;
    CB_PATTERN_DIAMOND    = 1;
    CB_PATTERN_CIRCLE     = 2;


{------------------------------------------------------------------------------}
procedure CloseProgressWindow(Dummy : Integer);
begin
    if CB_PROGRESS_FORM <> nil then
    begin
        CB_PROGRESS_FORM.Close;
        CB_PROGRESS_FORM.Free;
    end;

    CB_PROGRESS_FORM := nil;
    CB_PROGRESS_BAR := nil;
    CB_PROGRESS_LABEL := nil;
    CB_PROGRESS_PERCENT := nil;

    CB_PROGRESS_MAX := 0;
    CB_PROGRESS_POS := 0;
    CB_PROGRESS_LAST_UI := -1;
end;


{------------------------------------------------------------------------------}
procedure ShowProgressWindow(ATitle, AStatus : String; AMax : Integer);
begin
    CloseProgressWindow(0);

    if AMax <= 0 then
        AMax := 1;

    CB_PROGRESS_MAX := AMax;
    CB_PROGRESS_POS := 0;
    CB_PROGRESS_LAST_UI := -1;

    CB_PROGRESS_FORM := TForm.Create(nil);
    CB_PROGRESS_FORM.Caption := ATitle;
    CB_PROGRESS_FORM.Position := poScreenCenter;
    CB_PROGRESS_FORM.BorderStyle := bsDialog;
    CB_PROGRESS_FORM.ClientWidth := 430;
    CB_PROGRESS_FORM.ClientHeight := 118;

    CB_PROGRESS_LABEL := TLabel.Create(CB_PROGRESS_FORM);
    CB_PROGRESS_LABEL.Parent := CB_PROGRESS_FORM;
    CB_PROGRESS_LABEL.Left := 18;
    CB_PROGRESS_LABEL.Top := 16;
    CB_PROGRESS_LABEL.Width := 390;
    CB_PROGRESS_LABEL.Caption := AStatus;

    CB_PROGRESS_BAR := TProgressBar.Create(CB_PROGRESS_FORM);
    CB_PROGRESS_BAR.Parent := CB_PROGRESS_FORM;
    CB_PROGRESS_BAR.Left := 18;
    CB_PROGRESS_BAR.Top := 45;
    CB_PROGRESS_BAR.Width := 394;
    CB_PROGRESS_BAR.Height := 22;
    CB_PROGRESS_BAR.Min := 0;
    CB_PROGRESS_BAR.Max := CB_PROGRESS_MAX;
    CB_PROGRESS_BAR.Position := 0;

    CB_PROGRESS_PERCENT := TLabel.Create(CB_PROGRESS_FORM);
    CB_PROGRESS_PERCENT.Parent := CB_PROGRESS_FORM;
    CB_PROGRESS_PERCENT.Left := 18;
    CB_PROGRESS_PERCENT.Top := 80;
    CB_PROGRESS_PERCENT.Width := 394;
    CB_PROGRESS_PERCENT.Caption := '0%';

    CB_PROGRESS_FORM.Show;
    CB_PROGRESS_FORM.Update;
    CB_PROGRESS_BAR.Update;
end;


{------------------------------------------------------------------------------}
procedure SetProgressStatus(AStatus : String);
begin
    if CB_PROGRESS_LABEL = nil then Exit;

    CB_PROGRESS_LABEL.Caption := AStatus;
    CB_PROGRESS_LABEL.Update;
end;


{------------------------------------------------------------------------------}
procedure UpdateProgress(AIncrement : Integer);
var
    Percent : Integer;
begin
    if CB_PROGRESS_BAR = nil then Exit;

    CB_PROGRESS_POS := CB_PROGRESS_POS + AIncrement;

    if CB_PROGRESS_POS > CB_PROGRESS_MAX then
        CB_PROGRESS_POS := CB_PROGRESS_MAX;

    if CB_PROGRESS_MAX > 0 then
        Percent := (CB_PROGRESS_POS * 100) div CB_PROGRESS_MAX
    else
        Percent := 100;

    { Refresh only when the visible percentage changes.
      This keeps generation fast | layer: dense patterns. }
    if Percent <> CB_PROGRESS_LAST_UI then
    begin
        CB_PROGRESS_LAST_UI := Percent;

        CB_PROGRESS_BAR.Position := CB_PROGRESS_POS;
        CB_PROGRESS_BAR.Update;

        if CB_PROGRESS_PERCENT <> nil then
        begin
            CB_PROGRESS_PERCENT.Caption :=
                IntToStr(Percent) + '%   (' +
                IntToStr(CB_PROGRESS_POS) + ' / ' +
                IntToStr(CB_PROGRESS_MAX) + ')';
            CB_PROGRESS_PERCENT.Update;
        end;

        if CB_PROGRESS_FORM <> nil then
            CB_PROGRESS_FORM.Update;
    end;
end;


{------------------------------------------------------------------------------}
procedure FinishProgress(Dummy : Integer);
begin
    if CB_PROGRESS_BAR <> nil then
    begin
        CB_PROGRESS_POS := CB_PROGRESS_MAX;
        CB_PROGRESS_BAR.Position := CB_PROGRESS_MAX;
        CB_PROGRESS_BAR.Update;
    end;

    if CB_PROGRESS_PERCENT <> nil then
    begin
        CB_PROGRESS_PERCENT.Caption := '100%';
        CB_PROGRESS_PERCENT.Update;
    end;

    if CB_PROGRESS_FORM <> nil then
        CB_PROGRESS_FORM.Update;
end;


{------------------------------------------------------------------------------}
procedure InitDefaults(Dummy : Integer);
var
    I : Integer;
begin
    CB_LAYER_COUNT := 0;

    for I := 0 to 127 do
    begin
        CB_LAYER_SELECTED[I] := False;
        CB_LAYER_CHECKS[I] := nil;
    end;

    CB_PAD_SIZE_MM        := 1.00;
    CB_PITCH_X_MM         := 2.00;
    CB_PITCH_Y_MM         := 2.00;

    CB_COPPER_CLEAR_MM    := 0.50;
    CB_EDGE_CLEAR_MM      := 0.50;

    { Default = current staggered pad pattern. }
    CB_PATTERN_TYPE       := CB_PATTERN_DIAMOND;

    { OFF = individual free pads, easy single-item Delete. }
    CB_GROUP_AS_COMPONENT := False;

    CB_REMOVE_REQUESTED   := False;

    CB_PROGRESS_FORM := nil;
    CB_PROGRESS_BAR := nil;
    CB_PROGRESS_LABEL := nil;
    CB_PROGRESS_PERCENT := nil;
    CB_PROGRESS_MAX := 0;
    CB_PROGRESS_POS := 0;
    CB_PROGRESS_LAST_UI := -1;
end;


{------------------------------------------------------------------------------}
function PopulateCopperLayerChecks(Scroll : TScrollBox) : Integer;
var
    Stack        : IPCB_LayerStack;
    LayerObj     : IPCB_LayerObject;
    Layer        : TLayer;
    Ch           : TCheckBox;
    YPos         : Integer;
    CurrentFound : Boolean;
    I            : Integer;
begin
    Result := 0;
    CB_LAYER_COUNT := 0;
    CurrentFound := False;
    YPos := 8;

    Stack := Board.LayerStack;
    if Stack = nil then Exit;

    { AD 26.9.x-compatible signal-layer enumeration.
      eTopLayer..eBottomLayer covers positive signal copper layers.
      Negative Internal Plane layers are outside this range and are omitted. }
    for Layer := eTopLayer to eBottomLayer do
    begin
        LayerObj := Stack.LayerObject[Layer];

        if LayerObj <> nil then
        begin
            if LayerObj.IsInLayerStack then
            begin
                if CB_LAYER_COUNT <= 127 then
                begin
                    CB_LAYER_IDS[CB_LAYER_COUNT] := Layer;

                    Ch := TCheckBox.Create(Scroll);
                    Ch.Parent := Scroll;
                    Ch.Left := 8;
                    Ch.Top := YPos;
                    Ch.Width := 210;
                    Ch.Caption := LayerObj.Name;
                    Ch.Checked := False;

                    if Layer = Board.CurrentLayer then
                    begin
                        Ch.Checked := True;
                        CurrentFound := True;
                    end;

                    CB_LAYER_CHECKS[CB_LAYER_COUNT] := Ch;

                    Inc(CB_LAYER_COUNT);
                    Inc(Result);

                    YPos := YPos + 24;
                end;
            end;
        end;
    end;

    { If current layer is not a signal copper layer, select the first one. }
    if not CurrentFound then
    begin
        if CB_LAYER_COUNT > 0 then
            CB_LAYER_CHECKS[0].Checked := True;
    end;

    { Clear selection state before reading the dialog result. }
    for I := 0 to CB_LAYER_COUNT - 1 do
        CB_LAYER_SELECTED[I] := False;
end;


{------------------------------------------------------------------------------}
function IsOuterLayer(ALayer : TLayer) : Boolean;
begin
    Result := False;

    if ALayer = eTopLayer then
    begin
        Result := True;
        Exit;
    end;

    if ALayer = eBottomLayer then
    begin
        Result := True;
        Exit;
    end;
end;


{------------------------------------------------------------------------------}
function PatternName(Dummy : Integer) : String;
begin
    Result := 'Diamonds';

    if CB_PATTERN_TYPE = CB_PATTERN_SQUARE then
    begin
        Result := 'Squares';
        Exit;
    end;

    if CB_PATTERN_TYPE = CB_PATTERN_CIRCLE then
    begin
        Result := 'Circles';
        Exit;
    end;
end;


